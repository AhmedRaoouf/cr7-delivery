APP_NAME="CR7 Delivery"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Gamasa, New Mansoura and 15 May City are all Africa/Cairo. Leaving this at UTC
# puts every business_date, prep countdown and daily cap three hours out.
# Rows are stored in UTC and stay that way — Egypt observes DST again since
# 2023, so a local-time column has a duplicated hour every October with nothing
# on the row to tell the two apart. What reads as Cairo is every *display*, and
# every «today» boundary, through App\Support\BusinessTime and
# APP_BUSINESS_TIMEZONE below.
APP_TIMEZONE=UTC
APP_BUSINESS_TIMEZONE=Africa/Cairo
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8, not SQLite. The catalogue is not portable: the restaurant list, the menu
# and /search all use whereFullText(), and the fullText indexes on `restaurants` and
# `products` exist only on MySQL. On SQLite those three endpoints throw.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cr7_delivery
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Which channel actually delivers the code. `log` writes it to
# storage/logs/laravel.log — nowhere a customer can reach — so it only works
# while `otp.mode` is `test` on ADM-46. See the OTP block below.
OTP_CHANNEL=log

# --- first sign-in password -------------------------------------------------
# The password every Admin-created account (captain, restaurant, sub-admin) receives on
# creation and on reset. All of them carry `must_change_password`, so it is good for
# exactly one sign-in.
#
# A value here is SHARED and KNOWN. Between the moment an account is created and the
# moment its owner first signs in, anyone who knows the phone number can sign in as them.
# It is set because nothing here delivers a password — no mail, no SMS — and dictating
# twelve random characters over the phone was losing accounts.
#
# LEAVE IT EMPTY BEFORE LAUNCH and every issued password becomes random again:
#   TEMP_PASSWORD_DEFAULT=
TEMP_PASSWORD_DEFAULT=123456789

# ----------------------------------------------------------------------------
# SMS Misr — the OTP gateway. Check it with `php artisan cr7:sms-doctor` before
# trusting it, because every fault on this path is silent: SMS Misr answers
# HTTP 200 with the error in the body, and `POST /auth/otp/send` answers 200
# either way, so a broken gateway looks exactly like a working one.
#
# Three things must be true on the SMS Misr side before a LIVE send works, and
# none of them is in this file:
#   1. an APPROVED Sender ID  — `Active Sender IDs: 0` in the console means
#      every live send comes back 1904, whatever is written below.
#   2. POINTS in the account  — an empty wallet is code 1906. The «Test
#      Balance» is a different wallet and only spends at ENVIRONMENT=2.
#   3. the account provisioned for the MODE chosen below.
#
# ENVIRONMENT — 1 = live (real message, real points), 2 = test (SMS Misr
# validates the request and does NOT deliver it). Keep 2 until the Sender ID
# is approved; a test send proves the credentials and nothing else.
#
# LANGUAGE is an ENCODING, not a locale: 1 = English/GSM-7, which cannot carry
# an Arabic letter; 2 = Arabic; 3 = Unicode. Use 3 if Arabic arrives as question
# marks — the copy mixes Arabic with the Latin brand name.
#
# MODE — `sms` posts our own text to /api/SMS/ (success 1901). `otp` posts an
# SMS-Misr-hosted template id to /api/OTP/ (success 6000) and needs TEMPLATE.
# Egypt's A2P rules push transactional traffic onto registered templates, so ask
# SMS Misr which one this account is set up for.
# ----------------------------------------------------------------------------
SMS_MISR_URL=https://smsmisr.com/api/SMS/
SMS_MISR_OTP_URL=https://smsmisr.com/api/OTP/
SMS_MISR_BALANCE_URL=https://smsmisr.com/api/Balance/
SMS_MISR_MODE=sms
SMS_MISR_TEMPLATE=
SMS_MISR_ENVIRONMENT=2
SMS_MISR_LANGUAGE=2
SMS_MISR_USERNAME=
SMS_MISR_PASSWORD=
SMS_MISR_SENDER=

VITE_APP_NAME="${APP_NAME}"

# ----------------------------------------------------------------------------
# Sessions — D-120, config/cr7_auth.php.
#
# Minutes an access token lives. A client that sent `X-Auth-Refresh: 1` at
# sign-in renews it in the background with its refresh token; one that did not
# holds a legacy token that lives while it is used. How long a session may sit
# unused is NOT here: it is `auth.session_days` / `auth.admin_session_days` on
# the settings panel. Leave `sanctum.expiration` null — it would cut every
# legacy token at a fixed age, however recently it was used.
# ----------------------------------------------------------------------------
AUTH_ACCESS_MINUTES=60

# ----------------------------------------------------------------------------
# Maps — https://console.mapbox.com/account/access-tokens/
#
# A PUBLIC token only (`pk.…`). It is published to every client through
# GET /config by design, because the device fetches tiles directly.
# Leave it empty and the app falls back to OpenStreetMap tiles with no
# geocoding — everything still works, the street labels just get sparse.
#
# CARTO_API_KEY (free, carto.com/basemaps/apikey) buys the denser label set and
# a real dark style, so the client stops inverting light tiles in dark mode.
# It is NOT optional for that provider: keyless CARTO answers 200 with an
# «API KEY REQUIRED» watermark stamped across every tile, so `MapStyles` will
# not select CARTO without one.
# ----------------------------------------------------------------------------
MAPS_PROVIDER=mapbox
MAPBOX_TOKEN=
MAPBOX_STYLE_LIGHT=mapbox/streets-v12
MAPBOX_STYLE_DARK=mapbox/dark-v11
# The same two drawn in Arabic, published instead when the request is Arabic.
# Raster tiles take no language parameter — `streets-v12` / `dark-v11` print
# English whatever the client asks — so these are copies made in Mapbox Studio
# with the label layers set to `name_ar`, as `owner/style-id`. Empty: every
# client gets the pair above, as before. Each half falls back on its own.
MAPBOX_STYLE_LIGHT_AR=
MAPBOX_STYLE_DARK_AR=
CARTO_API_KEY=
CARTO_STYLE_LIGHT=voyager
CARTO_STYLE_DARK=dark_all
MAPS_DEFAULT_LAT=31.4472
MAPS_DEFAULT_LNG=31.5142
MAPS_COUNTRY=eg

# ----------------------------------------------------------------------------
# OTP — D-106. The code switch is NOT in this file any more.
#
# OTP_STATIC_MODE, OTP_STATIC_CODE, OTP_STATIC_ORDER_CODE and
# OTP_ECHO_IN_RESPONSE are deleted. Whether codes are real is decided on
# ADM-46, «التحقق والرسائل»:
#
#   otp.mode = sms    a random code through OTP_CHANNEL (the default)
#   otp.mode = test   the operator's otp.test_code, no SMS sent, echoed back
#                     by POST /auth/otp/send so the app can prefill it
#   auth.register_requires_otp = false   sign-up is phone + name + password
#
# An admin's reset code and every password-change code are real SMS whatever
# otp.mode says (D-107). Pickup and delivery codes are always random (D-108).
#
# The broken pair is otp.mode = sms with OTP_CHANNEL=log: the code is random
# and written only to storage/logs, so nobody receives anything. Every such
# send logs a warning. `php artisan cr7:sms-doctor` prints the mode, the bound
# channel and every missing SMS Misr credential in one table.
# ----------------------------------------------------------------------------

# --- Telescope ---------------------------------------------------------------
# It runs on the deployed API too, so an end-to-end run can be watched where it
# actually happens. Three switches decide that, and all three are read at boot:
#
#   TELESCOPE_ENABLED     the master switch. false and the provider never loads.
#   TELESCOPE_RECORD_ALL  false keeps only failures; true keeps every request,
#                         which is the point during a test run.
#   TELESCOPE_TOKEN       REQUIRED outside local. Open the panel once as
#                           https://<host>/telescope?telescope_token=<the token>
#                         and it is remembered in an httpOnly cookie for 8 hours.
#                         Unset, every Telescope URL answers 404 — that is
#                         deliberate, not a bug.
#
# Generate the token with:  php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
#
# Authorization, Cookie, passwords, OTPs and FCM tokens are redacted in every
# environment (TelescopeServiceProvider). Request *bodies* are not: whoever holds
# the token reads every order, address and phone number that moved through the
# API. Treat it as a production credential, and set TELESCOPE_ENABLED=false when
# the test run is over.
TELESCOPE_ENABLED=true
TELESCOPE_RECORD_ALL=true
TELESCOPE_TOKEN=
TELESCOPE_DRIVER=database
TELESCOPE_RESPONSE_SIZE_LIMIT=512

# ─── Realtime (Pusher Channels) ───────────────────────────────────────────────
# Turns the dashboards and both apps from polling onto sockets. Without these the
# app behaves exactly as before: BROADCAST_CONNECTION stays `null`, no event is
# sent, and every client keeps its polling fallback.
#
# The four values come from Pusher's dashboard → Channels → App Keys. The KEY is
# public (it is published to clients on GET /config); the SECRET never leaves the
# server.
BROADCAST_CONNECTION=null
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu
# Seconds. The broadcast happens inside the web request, so this caps how long a
# Pusher outage can hold an order accept open.
PUSHER_TIMEOUT=6

# ─── Storage ──────────────────────────────────────────────────────────────────
# Product photos, restaurant logos, banners and avatars. `public` writes to
# storage/app/public and serves through the public/storage symlink that
# `php artisan storage:link` creates — run it once on a new server, or every
# upload answers 200 with a URL that answers 404.
#
# Uploads live outside the repository tree, so a `git pull` deploy never touches
# them. Nothing else is needed: no bucket, no keys, no CDN account.
PUBLIC_UPLOAD_DISK=public

# --- Firebase Cloud Messaging (doc 11) -------------------------------------
# FIREBASE_CREDENTIALS is the path to the service-account JSON from
# Firebase console → Project settings → Service accounts → Generate new private key.
#
# It is a private key. Upload it with the file manager, do NOT commit it, and do
# NOT put it under public/ or storage/app/public/ — the second is symlinked into
# the first by `php artisan storage:link`, so anything there is a public URL.
#
# storage/app/firebase/ is the right place: this application routes every request
# through Laravel, so a URL pointing at it answers 404.
#
# After editing this line: php artisan config:cache
FIREBASE_CREDENTIALS=/home/USER/domains/cr7-delivery.com/public_html/storage/app/firebase/service-account.json
FIREBASE_PROJECT_ID=cr7-delivery

# --- Sign in with Apple / Google (POST /auth/social) ------------------------
# The **audience allow-list**: every `aud` this deployment accepts on an
# id_token, comma-separated. Leave a line empty and that provider is refused
# outright with `social_not_configured` — that is deliberate. An empty list can
# never mean «accept any audience», because a token minted for any other app in
# the world would then sign somebody in here.
#
# These are public identifiers, not secrets: they ship inside the app binary.
#
# APPLE_CLIENT_IDS   the iOS bundle id — com.cr7delivery.cr7Delivery — and, only
#                    if Apple sign-in is ever offered on the web, the Services ID.
#
# GOOGLE_CLIENT_IDS  BOTH the iOS OAuth client id AND the **Web** client id.
#                    Android's SDK signs its id_token with the *web* client, not
#                    the Android one, so a list holding only the iOS id gives a
#                    working iPhone build and an Android build that fails every
#                    sign-in with `social_token_invalid`.
#                    Both come from Firebase console → Authentication → Sign-in
#                    method → Google, or Google Cloud → APIs & Services →
#                    Credentials.
#
# After editing these lines: php artisan config:cache
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_IDS=
