APP_NAME="CR7 Delivery"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Gamasa, New Mansoura and 15 May City are all Africa/Cairo. Leaving this at UTC
# puts every business_date, prep countdown and daily cap three hours out.
APP_TIMEZONE=Africa/Cairo
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8, not SQLite. The catalogue is not portable: the restaurant list, the menu
# and /search all use whereFullText(), and the fullText indexes on `restaurants` and
# `products` exist only on MySQL. On SQLite those three endpoints throw.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cr7_delivery
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ----------------------------------------------------------------------------
# Maps — https://console.mapbox.com/account/access-tokens/
#
# A PUBLIC token only (`pk.…`). It is published to every client through
# GET /config by design, because the device fetches tiles directly.
# Leave it empty and the app falls back to OpenStreetMap tiles with no
# geocoding — everything still works, the street labels just go missing.
# ----------------------------------------------------------------------------
MAPS_PROVIDER=mapbox
MAPBOX_TOKEN=
MAPBOX_STYLE_LIGHT=mapbox/streets-v12
MAPBOX_STYLE_DARK=mapbox/dark-v11
MAPS_DEFAULT_LAT=31.4472
MAPS_DEFAULT_LNG=31.5142
MAPS_COUNTRY=eg

# ----------------------------------------------------------------------------
# OTP
#
# !! While OTP_STATIC_MODE=true, EVERY phone number signs in with the same
# !! code. Correct for a staging server that has no SMS gateway; a full account
# !! takeover on a public one. Set it to false the day an SMS channel is bound.
# ----------------------------------------------------------------------------
OTP_STATIC_MODE=true
OTP_STATIC_CODE=123456
OTP_STATIC_ORDER_CODE=1234
OTP_ECHO_IN_RESPONSE=true
