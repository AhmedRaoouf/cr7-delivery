<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <!-- `baseline` silences one known vendor deprecation; see phpunit-baseline.xml. -->
    <source baseline="phpunit-baseline.xml">
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- The suite grew from 393 tests to 453 on 2026-09-08, and `ImageOptimizerTest`
             now exhausts PHP's default 128 MB inside a full run — it passes alone. The
             failure is an out-of-memory abort with no failing assertion, which reads as
             the runner crashing rather than as a test problem. `artisan test` spawns a
             subprocess that does not inherit a command-line `-d`, so the limit has to be
             here. -->
        <ini name="memory_limit" value="1G"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- MySQL, not SQLite: the catalogue and search use whereFullText() and the
             fullText indexes on `restaurants` and `products` are MySQL-only, so an
             in-memory SQLite suite cannot exercise three of the customer endpoints.
             Create it once: CREATE DATABASE cr7_delivery_test; -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="cr7_delivery_test"/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- Pinned, not inherited. MapsAndOtpTest asserts the provider it gets back
             from GET /config; without this a developer who sets MAPS_PROVIDER=osm in
             their own .env (which is the right setting for a machine with no Mapbox
             token) fails a test that has nothing to do with what they changed. -->
        <env name="MAPS_PROVIDER" value="mapbox"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
